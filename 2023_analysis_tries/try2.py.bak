def get_callibration_ticks(chunks, freq):
    callibration = ["smile__{}", "angry__{}", "blink__{}"]
    ticks = []
    for c in callibration:
        for i in range(0,3):
            chunk = chunks[str.format(c,i)]
            ticks += [int(chunk.Start.Time) * freq, int(chunk.End.Time) * freq]
    start = ticks[0]
    end = ticks[-1]
    ticks = [int(t-start) for t in ticks]
    return ticks, start, end

def window_rms_signal(signal, window_size):
    return np.sqrt(np.convolve(signal**2, (np.ones(window_size)/float(window_size))))

def resample_components(components, freq, new_freq):
    return resample(components, int(len(components[0]) * new_freq / freq), axis=1)

def smooth_signal_with_averaging_window(signal, window_size):
    window = np.ones(window_size)/window_size
    return np.convolve(signal, window, mode='same')

def smooth_matrix_of_signals_with_averaging_window(matrix, window_size):
    return np.array([smooth_signal_with_averaging_window(signal, window_size) for signal in matrix])

def window_rms_matrix(matrix, window_size):
    return np.array([window_rms_signal(signal, window_size) for signal in matrix])



def correlate(a_smile, b_smile, freq, windowInMs = 1000, maxLagInMs = 1000, jumpInMs = 500 ):
    max_len = min(len(a_smile), len(b_smile))
    window = int(windowInMs * freq / 1000)
    maxLag = int(maxLagInMs * freq / 1000)
    jump = int(jumpInMs * freq / 1000)
    corrs = []
    lags = []
    for i in range(window, max_len - (window+maxLag), jump):
        a = a_smile[i-window:i+window+maxLag]
        b = b_smile[i:i+window]
        ccArr = np.correlate(a,b, mode="valid")
        max_corr = np.max(ccArr)
        max_corr_lag = np.argmax(ccArr)
        corrs.append(max_corr)
        lags.append(max_corr_lag)
    
    return np.mean(corrs), np.mean(lags)

